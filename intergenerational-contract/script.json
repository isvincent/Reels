 "segments": [
  {
   "id": "s1",
   "board": "hook",
   "clauses": [
    "今天的年輕人繳的保險費，",
    "其實正在支付爺爺奶奶的退休金。"
   ]
  },
  {
   "id": "s2",
   "board": "title",
   "clauses": [
    "這種世代之間互相扶持的默契，",
    "叫做「代際契約」。"
   ]
  },
  {
   "id": "s3",
   "board": "relay",
   "clauses": [
    "它就像一場接力：",
    "工作世代照顧上一代，",
    "並期待下一代將來照顧自己。"
   ]
  },
  {
   "id": "s4",
   "board": "payg",
   "clauses": [
    "許多國家的年金採用「隨收隨付」：",
    "用現在工作者繳的錢，",
    "支付現在退休者的年金。"
   ]
  },
  {
   "id": "s5",
   "board": "balance",
   "clauses": [
    "但少子化和高齡化讓天秤失衡：",
    "繳錢的人越來越少，",
    "領錢的人越來越多。"
   ]
  },
  {
   "id": "s6",
   "board": "balance",
   "clauses": [
    {
     "show": "根據國發會推估，臺灣在 2025 年進入超高齡社會，",
     "say": "根據國發會推估，臺灣在二零二五年進入超高齡社會，"
    },
    "也就是六十五歲以上人口超過兩成。"
   ]
  },
  {
   "id": "s7",
   "board": "beyond",
   "clauses": [
    "代際契約不只有錢：",
    "還包括環境、債務和資源，",
    "留給下一代什麼，也是一種責任。"
   ]
  },
  {
   "id": "s8",
   "board": "beyond",
   "clauses": [
    "解決之道包括年金改革、支持育兒，",
    "以及讓不同世代多對話。"
   ]
  },
  {
   "id": "s9",
   "board": "end",
   "clauses": [
    "想一想：你希望下一代，",
    "從你們這一代手中接到什麼？"
   ]
  }
 ]
